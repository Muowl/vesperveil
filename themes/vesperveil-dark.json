  "tokenColors": [
    {
      "name": "Default",
      "scope": [
        "source"
      ],
      "settings": {
        "foreground": "#E8DFDA",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A6979F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ED829F",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#9FCB8F",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#EFA777",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#E5B55F",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#BE9BE9",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E8DFDA",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#A6979F",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.function.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#BE9BE9",
        "fontStyle": ""
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#EFA777",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ED829F",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E5B55F",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#E5B55F",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F27D88",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#ED829F",
      "italic": false,
      "bold": false
    },
    "modifier": {
      "foreground": "#ED829F",
      "italic": false,
      "bold": false
    },
    "string": {
      "foreground": "#9FCB8F",
      "italic": false,
      "bold": false
    },
    "regexp": {
      "foreground": "#9FCB8F",
      "italic": false,
      "bold": false
    },
    "number": {
      "foreground": "#EFA777",
      "italic": false,
      "bold": false
    },
    "enumMember": {
      "foreground": "#EFA777",
      "italic": false,
      "bold": false
    },
    "variable.readonly": {
      "foreground": "#EFA777",
      "italic": false,
      "bold": false
    },
    "function": {
      "foreground": "#E5B55F",
      "italic": false,
      "bold": false
    },
    "method": {
      "foreground": "#E5B55F",
      "italic": false,
      "bold": false
    },
    "type": {
      "foreground": "#BE9BE9",
      "italic": false,
      "bold": false
    },
    "class": {
      "foreground": "#BE9BE9",
      "italic": false,
      "bold": false
    },
    "interface": {
      "foreground": "#BE9BE9",
      "italic": false,
      "bold": false
    },
    "enum": {
      "foreground": "#BE9BE9",
      "italic": false,
      "bold": false
    },
    "typeParameter": {
      "foreground": "#BE9BE9",
      "italic": false,
      "bold": false
    },
    "namespace": {
      "foreground": "#BE9BE9",
      "italic": false,
      "bold": false
    },
    "decorator": {
      "foreground": "#BE9BE9",
      "italic": false,
      "bold": false
    },
    "variable": {
      "foreground": "#E8DFDA",
      "italic": false,
      "bold": false
    },
    "parameter": {
      "foreground": "#E8DFDA",
      "italic": false,
      "bold": false
    },
    "property": {
      "foreground": "#E8DFDA",
      "italic": false,
      "bold": false
    },
    "operator": {
      "foreground": "#A6979F",
      "italic": false,
      "bold": false
    },
    "comment": {
      "foreground": "#A6979F",
      "italic": true
    }
  }
}
